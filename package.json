{
  "name": "proofloop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run typecheck && npm run lint && vite build",
    "preview": "vite preview",
    "verify:kane": "kane-cli testmd run .testmuai/tests/proofboard_release_test.md --agent --headless --on-lock-conflict wait --retry",
    "verify:kane:production": "kane-cli testmd run .testmuai/tests/proofboard_production_test.md --agent --headless --on-lock-conflict wait --retry",
    "verify:loop": "node scripts/kane-loop.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2"
  }
}
